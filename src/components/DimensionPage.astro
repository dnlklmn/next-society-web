---
/**
 * Philosophy / Mission / Playbook.
 *
 * These are the three dimensions from the manifesto section of the home page, so
 * the page opens the way that section reads: numbered mono eyebrow, dimension
 * title, lead, CTA row. Then the ported prose, then a pointer into the Compendium
 * where the dimension is actually written.
 */
import Button from "./Button.astro";
import ProseSection from "./ProseSection.astro";

interface Props {
  number: string;
  title: string;
  lead: string;
  actions: { label: string; href: string; appearance?: "filled" | "outline" | "inverse" }[];
  sections: { title: string; body: string }[];
  related?: { label: string; href: string };
}
const { number, title, lead, actions, sections, related } = Astro.props;
---

<header class="bg-paper pt-[48px] pb-[48px] md:pt-[72px] md:pb-[64px]">
  <div class="ns-container">
    <p class="ns-type-eyebrow font-mono text-ink-muted">{number} / THE MANIFESTO</p>

    <h1 class="ns-type-section mt-[var(--ns-space-16)] font-medium text-ink">{title}</h1>

    <p class="ns-type-body-intro mt-[var(--ns-space-24)] max-w-[56ch] text-ink-muted">{lead}</p>

    <div class="mt-[var(--ns-space-24)] grid grid-cols-2 gap-[var(--ns-space-16)] md:flex md:flex-wrap">
      {actions.map((action) => (
        <Button
          label={action.label}
          href={action.href}
          appearance={action.appearance}
          external
          class="w-full md:w-auto"
        />
      ))}
    </div>
  </div>
</header>

<div class="bg-paper py-[16px] md:py-[24px]">
  <div class="ns-container">
    {sections.map((section) => <ProseSection title={section.title} body={section.body} />)}

    {related && (
      <section class="border-t border-line py-[40px] md:py-[48px]">
        <a
          href={related.href}
          class="ns-type-action inline-flex items-center gap-[var(--ns-space-12)] text-ink no-underline hover:underline underline-offset-4"
        >
          {related.label}
          <span aria-hidden="true" class="text-[21px] leading-[24px]">→</span>
        </a>
      </section>
    )}
  </div>
</div>
